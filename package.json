{
  "name": "@yk-yong/react-native-boilerplate",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --mode=developmentDebug --appIdSuffix sit --no-packager",
    "android:staging": "react-native run-android --mode=stagingDebug --appIdSuffix uat --no-packager",
    "android:prod": "react-native run-android --mode=productionDebug --no-packager",
    "android:clean": "cd android && ./gradlew clean",
    "android:aab:sit": "cd android && ./gradlew bundleDevelopmentRelease",
    "android:aab:uat": "cd android && ./gradlew bundleStagingRelease",
    "android:aab": "cd android && ./gradlew bundleProductionRelease",
    "android:apk:sit": "cd android && ./gradlew assembleDevelopmentRelease",
    "android:apk:uat": "cd android && ./gradlew assembleStagingRelease",
    "android:apk": "cd android && ./gradlew assembleProductionRelease",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-vector-icons/fontawesome6": "^13.1.3",
    "@react-navigation/native": "7.3.17",
    "@react-navigation/native-stack": "7.18.9",
    "i18next": "26.4.0",
    "react": "19.2.3",
    "react-i18next": "17.0.12",
    "react-native": "0.87.0",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.27.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >= 26.0.0"
  },
  "workspaces": [
    "src/app/screens",
    "src/app/modules",
    "src/app/navigation",
    "src/packages/react-navigation",
    "src/packages/react-native-ui",
    "src/packages/i18n"
  ]
}
